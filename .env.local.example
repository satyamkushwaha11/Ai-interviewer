# --- AI provider ------------------------------------------------------------
# "openai" (default when OPENAI_API_KEY is set) or "gemini".
AI_PROVIDER=openai

# OpenAI — or any OpenAI-compatible gateway (e.g. OpenRouter) via OPENAI_BASE_URL.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts   # hosted voice; only works against api.openai.com

# Google Gemini (used when AI_PROVIDER=gemini, or when no OPENAI_API_KEY).
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-1.5-flash

# --- Neon Postgres (required) -----------------------------------------------
# Neon dashboard → Connect → pooled connection string. Then: npm run db:migrate
DATABASE_URL=

# --- Google sign-in (optional) ----------------------------------------------
# Google Cloud Console → Credentials → OAuth client (Web application)
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=https://your-domain.example   # only needed behind a proxy / custom domain
